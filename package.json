{
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 62003",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 62003",
    "test": "npm run test:unit && npm run test:smoke && npm run test:render",
    "test:unit": "esbuild test/thermal.test.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/thermal.test.mjs && node node_modules/.cache/thermal.test.mjs",
    "test:smoke": "esbuild test/smoke.test.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/smoke.test.mjs && node node_modules/.cache/smoke.test.mjs",
    "test:render": "esbuild test/render.test.tsx --bundle --platform=node --format=esm --jsx=automatic --external:jsdom --outfile=node_modules/.cache/render.test.mjs && node node_modules/.cache/render.test.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typescript": "^5.8.3",
    "vite": "^7.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.1.1"
  }
}
